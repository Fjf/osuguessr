# Copy to .env and adjust. All values are optional — defaults shown.

# Library source: "stable" (osu!stable: Songs folder + .osu beatmap files)
# or "lazer" (osu!lazer: client.realm + files/ store).
OSU_SOURCE=stable

# --- osu!stable ---

# Folder with your osu! audio files (named by MD5, e.g. d41d….mp3)
OSU_SONGS_DIR=G:\Program Files\osu!\Songs

# Root of your osu! install (contains your downloaded beatmaps; used for
# title / artist / mapper / difficulty metadata). Can be the same as the
# songs folder's parent.
OSU_ROOT_DIR=G:\Program Files\osu!

# --- osu!lazer (only used when OSU_SOURCE=lazer) ---

# Your lazer data folder — the one containing client.realm and files/.
# OSU_SONGS_DIR / OSU_ROOT_DIR are ignored in lazer mode.
# Default locations (lazer can move this in Settings > Storage — if you
# changed it there, point OSU_LAZER_DIR at the new place):
#   Windows  %AppData%\osu                  e.g. C:\Users\you\AppData\Roaming\osu
#   Linux    ~/.local/share/osu
#   macOS    ~/Library/Application Support/osu
# OSU_LAZER_DIR=C:\Users\you\AppData\Roaming\osu
#
# Then uncomment the matching volume line in docker-compose.yml.

# Host port for the game
PORT=8090

# 0.0.0.0 = reachable from your LAN (share with friends); 127.0.0.1 = this machine only
HOST=0.0.0.0